{
  "multipart": [
    {
      "when": { "OR": [ { "rotation": "0" }, { "rotation": "1" }, { "rotation": "2" }, { "rotation": "3" } ] },
      "apply": { "model": "whimsical-ideas:block/soul_tablet_broken", "y": 0 }
    },
    {
      "when": { "OR": [ { "rotation": "4" }, { "rotation": "5" }, { "rotation": "6" }, { "rotation": "7" } ] },
      "apply": { "model": "whimsical-ideas:block/soul_tablet_broken", "y": 90 }
    },
    {
      "when": { "OR": [ { "rotation": "8" }, { "rotation": "9" }, { "rotation": "10" }, { "rotation": "11" } ] },
      "apply": { "model": "whimsical-ideas:block/soul_tablet_broken", "y": 180 }
    },
    {
      "when": { "OR": [ { "rotation": "12" }, { "rotation": "13" }, { "rotation": "14" }, { "rotation": "15" } ] },
      "apply": { "model": "whimsical-ideas:block/soul_tablet_broken", "y": 270 }
    }
  ]
}
